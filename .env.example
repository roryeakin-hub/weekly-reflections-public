# Weekly Reflections — environment variables
#
# Nothing here is required to run /api/preview except ANTHROPIC_API_KEY and the
# Gmail credentials. Sending requires two further variables, both of which
# default to "off". See README → Turning sending on.

# ── Anthropic ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-4-5.
# CLAUDE_MODEL=claude-sonnet-4-5

# ── Gmail OAuth ────────────────────────────────────────────────────
# See SETUP.md. Used for BOTH sending and reading replies. Reading is not
# optional: the mail archive IS the memory. Scopes needed are gmail.send and
# gmail.readonly.
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...

SENDER_EMAIL=you@example.com
# Optional display name on the From: line.
# SENDER_NAME=Weekly Reflection

# ── Security ───────────────────────────────────────────────────────
# Required. Guards every endpoint, including cron. Without it, every request
# is refused — including yours.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Sending (BOTH required before any mail moves) ──────────────────
# Master switch. Must be the exact string "true". Defaults to off so that a
# fresh deployment cannot mail anyone by accident.
SENDING_ENABLED=false
# Comma-separated. Empty by default.
RECIPIENTS=

# ── Recipient context (the highest-leverage setting here) ──────────
# Who these people are and what they are working through, in concrete terms.
# This is the single biggest lever on output quality, and it is kept out of the
# repository on purpose: written well, it describes real people, and specific
# descriptions of real people do not belong in a public git history.
#
# Without it, lib/config.js falls back to a generic description and the
# questions get noticeably blander. That is the intended incentive.
PROJECT_CONTEXT=

# ── Optional behaviour ─────────────────────────────────────────────
# The series name. WARNING: this is also the key used to find prior emails in
# the archive, which is where all state comes from. Changing it after you have
# started makes the system forget everything and restart at week 1.
# SUBJECT_PREFIX=Weekly Reflection

# IANA timezone for dates and same-day deduplication. Defaults to UTC.
# TIMEZONE=America/Los_Angeles

# A fixed question asked every week as a 4th item. ON by default, because the
# three rotating questions give variety but no comparability, and a constant
# question is the only thing you can look back over six months and measure.
# Set to "false" to drop it.
# INCLUDE_PROGRESS_ANCHOR=false
# Override the wording:
# PROGRESS_ANCHOR_QUESTION=And regardless: what changed this week to move you toward your goals?

# How far back the weekly article search reaches, in days. Defaults to 30.
# A window near your send cadence causes repeats.
# RESOURCE_WINDOW_DAYS=30
